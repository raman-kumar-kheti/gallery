# ─────────────────────────────────────────────────────────
# Gallery SaaS — Environment Variables
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Gallery
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ── Database ─────────────────────────────────────────────
POSTGRES_USER=gallery
POSTGRES_PASSWORD=gallery_secret
POSTGRES_DB=gallery_db
DATABASE_URL=postgresql+asyncpg://gallery:gallery_secret@localhost:5432/gallery_db

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_to_a_long_random_secret_at_least_64_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Cloudflare R2 (S3-compatible) ────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=gallery-uploads
R2_PUBLIC_URL=https://your_r2_public_domain.com

# ── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── FAISS ────────────────────────────────────────────────
FAISS_INDEX_DIR=./indexes

# ── Celery ───────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Frontend (Next.js public) ────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_to_a_long_random_nextauth_secret

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=debug
